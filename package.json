{
  "name": "mf-vite-warm-cache-react-dom-repro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:force": "vite --force --host 127.0.0.1 --port 5173 --strictPort",
    "clean": "node -e \"import('node:fs').then(({ rmSync }) => rmSync('node_modules/.vite', { recursive: true, force: true }))\""
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@module-federation/vite": "1.23.0",
    "@vitejs/plugin-react": "6.0.0",
    "vite": "8.3.1"
  }
}
